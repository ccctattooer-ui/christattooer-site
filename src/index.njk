---
layout: layouts/catalog.njk
title: Flash & custom tattoo
description: Pick a flash design or bring your own idea. Traditional tattoos by Chris at Tattoo Peace, Vancouver, WA.
permalink: /flash/
---
{% set cats = flash | uniqueCats %}
<div class="layout">
  <aside class="side">
    <h4>Browse flash</h4>
    <ul class="cats">
      <li class="on" data-cat="all">All designs<span>{{ flash | length }}</span></li>
      {%- for c in cats %}
      <li data-cat="{{ c }}">{{ c }}<span>{{ (flash | where("category", c)) | length }}</span></li>
      {%- endfor %}
    </ul>
    <p class="fine"><b>Also in the catalog</b><a href="/work/">Healed &amp; recent work</a> · <a href="/book/">Book</a> · <a href="/aftercare/">Aftercare</a> · <a href="/about/">About</a></p>
    <p class="fine"><b>Pricing</b>Shop minimum {{ site.pricing.shopMinimum | money }}. {{ site.pricing.note }} Deposit {{ site.pricing.deposit | money }}, applied to the tattoo.</p>
    <p class="fine"><b>Hours</b>{{ site.hoursLong }}</p>
{% set spotId = "flash" %}{% include "partials/sticker-spot.njk" %}
  </aside>

  <main class="main">
    {%- if home.howto.show %}
    <div class="howto">
      <div class="h">{{ home.howto.heading | upper }}</div>
      {%- for s in home.howto.steps %}<div class="s"><b>{{ loop.index }}</b>{{ s }}</div>{% endfor %}
    </div>
    {%- endif %}

    <div class="bar">
      <h1>{{ home.catalogHeading }}</h1>
      <span class="cnt">Showing <span id="shown">{{ flash | length }}</span> of {{ flash | length }}</span>
      {%- if eggs.wheel.show %}<button class="spin-open" type="button" id="spin-open">{{ eggs.wheel.label }}</button>{% endif %}
    </div>
    <div class="grid" id="grid">
      {%- if home.custom.show %}
      <div class="item custom" data-sku="CU-000" data-name="Custom work" data-cat="Custom" data-button="{{ home.custom.button }}">
        <div class="art">CUSTOM<br>WORK</div>
        <div class="sku"><span>CU-000</span><i>Quoted</i></div>
        <h3>{{ home.custom.title }}</h3>
        <dl class="spec"><dt>Consult</dt><dd>free</dd><dt>Min</dt><dd>{{ site.pricing.shopMinimum | money }}</dd></dl>
        <button class="add" type="button">{{ home.custom.button }}</button>
      </div>
      {%- endif %}
      {%- for f in flash %}
      <div class="item" data-sku="{{ f.sku }}" data-name="{{ f.name }}" data-cat="{{ f.category }}" data-size="{{ f.size }}" data-price="{{ f.price }}">
        <div class="art"><img src="{{ f.image }}" alt="{{ f.name }} flash design" loading="lazy" width="520" height="520"></div>
        <div class="sku"><span>{{ f.sku }}</span>{% if f.available %}<i>Ready</i>{% else %}<i class="off">Claimed</i>{% endif %}</div>
        <h3>{{ f.name }}</h3>
        <dl class="spec"><dt>Category</dt><dd>{{ f.category }}</dd>{% if f.size %}<dt>Size</dt><dd>{{ f.size }}</dd>{% endif %}{% if f.hours %}<dt>Est. time</dt><dd>{{ f.hours | hrs }}</dd>{% endif %}<dt>Price</dt><dd>{{ f.price | money }}</dd></dl>
        {%- if f.notes %}<p class="fine" style="margin:0">{{ f.notes }}</p>{% endif %}
        <button class="add" type="button"{% if not f.available %} disabled{% endif %}>Add to request</button>
      </div>
      {%- endfor %}
    </div>
    <div class="nores" id="nores" hidden>Nothing matches that. Try another word, or <a href="/book/">request custom work</a>.</div>

    {%- if home.recent.show %}
    {%- set featured = (work | visible | where("featured", true)) %}
    <div class="bar"><h2>{{ home.recent.heading }}</h2><a href="/work/" style="font-size:13px;font-weight:700">All {{ (work | visible) | length }} photos →</a></div>
    <div class="hlist">
      {%- for w in featured %}{% if loop.index <= home.recent.count %}
      <a class="hrow" href="/work/#{{ w.file }}"><img src="{{ w.thumb }}" alt="{{ w.title }}" loading="lazy"><div><b>{{ w.title }}</b><small>{{ w.placement }}{% if w.style %} · {{ w.style }}{% endif %}{% if w.hours %} · {{ w.hours }} hr{% endif %}</small></div><em>View</em></a>
      {%- endif %}{% endfor %}
    </div>
    {%- endif %}
  </main>
</div>

{%- if eggs.wheel.show %}
{#- The wheel lives in a dialog so the catalog itself stays uncluttered. It reads the cards already
    on the page, so it costs no extra data, and ADD TO REQUEST just presses the real card's button. -#}
<dialog class="wheelbox" id="wheelbox" aria-label="Spin the wheel for a flash design">
  <div class="pane-title"><img class="pico" src="/assets/icons/win-arcade-32.png" alt="" width="32" height="32"><button class="x" id="wheel-close" type="button" aria-label="Close">×</button><b>wheel.exe</b></div>
  <div class="wheel-body">
    <p class="wheel-intro">Shops have been doing this forever. Give it a spin and take what you get.</p>
    <div class="wheel-stage">
      <span class="wheel-needle" aria-hidden="true"></span>
      <svg id="wheel-svg" viewBox="0 0 200 200" role="img" aria-label="Prize wheel of flash designs"></svg>
    </div>
    <button class="spin-go" type="button" id="spin-go">SPIN IT</button>
    <div class="wheel-out" id="wheel-out" aria-live="polite">
      <p class="wheel-idle">The needle is at the top. Whatever it lands on is yours.</p>
    </div>
  </div>
</dialog>
{%- endif %}
{%- if eggs.wheel.show %}
<script src="/js/wheel.js" defer></script>
{%- endif %}
