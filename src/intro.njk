---
layout: layouts/intro.njk
title: Welcome
description: Chris Columbus, traditional tattooer at Tattoo Peace in Vancouver, WA. Flash, healed work, paintings, games and more.
permalink: /
eleventyExcludeFromCollections: true
---
<main class="boot">
  <p class="welcome"><b>{{ landing.kicker | upper }}</b>{{ landing.welcome }}</p>

  <div class="tv" id="tv" role="button" tabindex="0" aria-label="Enter the site">
    <div class="cabinet">
      <div class="bezel">
        <div class="screen">
          <video id="montage" autoplay muted loop playsinline preload="auto" poster="/assets/intro/poster.jpg" aria-label="Short montage from the shop">
            <source src="/assets/intro/montage.mp4" type="video/mp4">
          </video>
          <div class="scan"></div><div class="rgb"></div><div class="glare"></div><div class="flicker"></div>
          <div class="osd"><b>CH {{ landing.channel }}</b>{{ landing.screenLabel | upper }}</div>
          <div class="caption">{{ landing.caption | upper }} <i>▮</i></div>
        </div>
      </div>
      <div class="panel">
        <span class="brand">{{ landing.plate | upper }}</span>
        <div class="knobs"><span class="knob"></span><span class="knob"></span><span class="led"></span></div>
      </div>
    </div>
  </div>

  <a class="power" href="/flash/" id="enter"><i></i>{{ landing.button | upper }}</a>
  <p class="skip">{{ (landing.footer or (site.hoursShort + " · " + site.booksStatus)) | upper }}</p>
</main>
