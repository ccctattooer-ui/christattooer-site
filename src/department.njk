---
layout: layouts/os.njk
pagination:
  data: departments
  size: 1
  alias: dept
  # Every department page, not just the first, so they all reach the sitemap.
  addAllPagesToCollections: true
permalink: "/{{ dept.slug }}/"
eleventyComputed:
  title: "{{ dept.name }}"
  description: "{{ dept.blurb }}"
---
{%- if dept.slug == "games" %}{% include "games.njk" %}{% elif dept.slug == "paintings" %}{% include "paintings.njk" %}{% elif dept.slug == "spacecraft" %}{% include "spacecraft.njk" %}{% else %}
<section class="win" id="w-readme" style="left:140px;top:70px;width:min(460px,calc(100vw - 32px))">
  <div class="title"><img class="wico" src="/assets/icons/win-txt-32.png" alt="" width="32" height="32"><button class="x" type="button" aria-label="Close">×</button><b>{{ dept.slug }}.txt</b></div>
  <div class="body txt">
    <h1>{{ dept.name }}</h1>
    <p>{{ dept.blurb }}</p>
    <p class="status">Status: {{ dept.status }}</p>
    {#- Roadworks show while a department's own status still says it is not open. Change the status
        in the admin and they retire themselves. -#}
    {%- set s = dept.status | lower %}
    {%- set notOpen = ("soon" in s) or ("later" in s) or ("construction" in s) %}
    {%- if eggs.construction.show and notOpen %}
    <div class="roadworks" aria-label="This department is not open yet">
      <div class="barricade"></div>
      <svg class="digger" viewBox="0 0 52 44" role="img" aria-label="Digger">
        <g shape-rendering="crispEdges">
          <rect x="6" y="24" width="30" height="12" fill="var(--yellow)" stroke="var(--ink)" stroke-width="2"/>
          <rect x="12" y="14" width="14" height="10" fill="#8FD6FF" stroke="var(--ink)" stroke-width="2"/>
          <path d="M34 26l14-12" stroke="var(--ink)" stroke-width="4"/>
          <path d="M44 10h8v8h-8z" fill="#7a7263" stroke="var(--ink)" stroke-width="2"/>
          <circle cx="14" cy="38" r="5" fill="var(--ink)"/><circle cx="30" cy="38" r="5" fill="var(--ink)"/>
        </g>
      </svg>
      <div class="ticker"><span>&#9733; {{ eggs.construction.marquee }} &#9733; {{ eggs.construction.marquee }} &#9733; </span></div>
{% set spotId = "store" %}{% include "partials/sticker-spot.njk" %}
    </div>
    {%- endif %}
    {%- if dept.images.length %}
    <p><a class="btn" href="#" data-open="w-gallery">OPEN PHOTOS</a> <a class="btn ghost" href="/flash/">BACK TO CATALOG</a></p>
    {%- else %}
    <p><a class="btn" href="https://instagram.com/{{ site.instagram }}">ASK ON INSTAGRAM</a> <a class="btn ghost" href="/flash/">BACK TO CATALOG</a></p>
    {%- endif %}
  </div>
</section>

{%- if dept.images.length %}
<section class="win" id="w-gallery" style="left:520px;top:110px;width:min(620px,calc(100vw - 32px))">
  <div class="title"><img class="wico" src="/assets/icons/win-gallery-32.png" alt="" width="32" height="32"><button class="x" type="button" aria-label="Close">×</button><b>{{ dept.name }} ({{ dept.images.length }})</b></div>
  <div class="body">
    <div class="gallery">
      {%- for im in dept.images %}
      <figure><a href="{{ im.image }}"><img src="{{ im.thumb }}" alt="{{ im.caption }}" loading="lazy"></a><figcaption>{{ im.caption | slug }}.jpg</figcaption></figure>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}
{%- endif %}
