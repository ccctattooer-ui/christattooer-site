---
layout: layouts/catalog.njk
title: Page not found
description: That page isn't here. Head back to the flash catalog.
permalink: /404.html
eleventyExcludeFromCollections: true
---
<main class="main" style="max-width:760px;margin:0 auto">
  <div class="pane">
    <div class="pane-title"><span class="x" aria-hidden="true">×</span><img class="pico" src="/assets/icons/win-txt-32.png" alt="" width="32" height="32"><b>404.txt</b></div>
    <div class="pane-body prose">
      <h1>{{ notFound.heading }}</h1>
      <p class="lede">{{ notFound.lede }}</p>
      <p>{{ notFound.intro }}</p>
      <ul>
        {%- for l in notFound.links %}
        <li><a href="{{ l.url }}">{{ l.label }}</a></li>
        {%- endfor %}
      </ul>
      <p>{{ notFound.outro }} <a href="https://instagram.com/{{ site.instagram }}">@{{ site.instagram }}</a></p>
    </div>
  </div>
</main>
