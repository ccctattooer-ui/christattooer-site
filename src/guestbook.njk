---
layout: layouts/catalog.njk
title: Guestbook
description: Sign the guestbook. Healed work, first tattoos, or just say hello.
permalink: /guestbook/
---
<main class="main" style="max-width:760px;margin:0 auto">
  <div class="bar"><h1>{{ guestbookPage.heading }}</h1><span class="cnt" id="gb-count"></span></div>
  <p class="lede" style="max-width:60ch;margin:0 0 18px">{{ guestbookPage.blurb }}</p>

  <div class="pane">
    <div class="pane-title"><span class="x" aria-hidden="true">×</span><img class="pico" src="/assets/icons/win-form-32.png" alt="" width="32" height="32"><b>sign.form</b></div>
    <div class="pane-body">
      <form class="gb-form" id="gb-form" novalidate>
        <p class="hp"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
        <div class="two">
          <div><label for="gb-name">Your name</label><input id="gb-name" name="name" maxlength="24" autocomplete="name" placeholder="or leave it blank"></div>
          <div><label for="gb-msg">Say something</label><input id="gb-msg" name="message" maxlength="180" required placeholder="{{ guestbookPage.placeholder }}"></div>
        </div>
        <button class="send" type="submit" id="gb-send">SIGN THE BOOK</button>
        <p class="alt" id="gb-status">{{ guestbookPage.note }}</p>
      </form>
    </div>
  </div>

  <div class="gb-list" id="gb-list" aria-live="polite">
    <p class="fine">Loading the book…</p>
  </div>
</main>
<script src="/js/guestbook.js" defer></script>
