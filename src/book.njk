---
layout: layouts/catalog.njk
title: Book
description: Three ways to book a tattoo with Chris at Tattoo Peace in Vancouver, WA.
---
<main class="main" style="max-width:1240px;margin:0 auto">
  <div class="bar"><h1>{{ booking.heading }}</h1><span class="cnt">{{ site.hoursShort }} · other days by request</span></div>
  <div class="routes">
    <div class="route primary">
      <h2>{{ booking.routes.request.title }}</h2>
      <p>{{ booking.routes.request.text }}</p>
      <a class="go" href="#request">{{ booking.routes.request.link }}</a>
    </div>
    <div class="route">
      <h2>{{ booking.routes.square.title }}</h2>
      <p>{{ booking.routes.square.text }}</p>
      <a class="go" href="{{ site.squareBooking }}">{{ booking.routes.square.link }}</a>
    </div>
    <div class="route">
      <h2>{{ booking.routes.instagram.title }}</h2>
      <p>{{ booking.routes.instagram.text }}</p>
      <a class="go" href="https://instagram.com/{{ site.instagram }}">{{ booking.routes.instagram.link }}</a>
    </div>
  </div>

  <div class="pane" id="request" style="max-width:760px">
    <div class="pane-title"><span class="x" aria-hidden="true">×</span><b>request.form</b></div>
    <div class="pane-body">
      <p class="fine" style="font-size:14px;margin:0 0 12px"><b>Picked from the catalog</b><span id="picks-summary"></span></p>
      <form class="bookform" name="tattoo-request" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field" enctype="multipart/form-data">
        <input type="hidden" name="form-name" value="tattoo-request">
        <input type="hidden" name="picks" id="b-picks">
        <p class="hp"><label>Leave this empty <input name="bot-field"></label></p>
        <div class="two">
          <div><label for="b-name">Name</label><input id="b-name" name="name" required autocomplete="name"></div>
          <div><label for="b-contact">Email or Instagram</label><input id="b-contact" name="contact" required></div>
        </div>
        <div><label for="b-notes">What do you want?</label><textarea id="b-notes" name="notes" placeholder="{{ booking.form.notesPlaceholder }}" required></textarea></div>
        <div class="two">
          <div><label for="b-place">Placement</label><input id="b-place" name="placement" placeholder="{{ booking.form.placementPlaceholder }}"></div>
          <div><label for="b-size">Size</label><input id="b-size" name="size" placeholder="{{ booking.form.sizePlaceholder }}"></div>
        </div>
        <div class="two">
          <div><label for="b-ref">Reference photos</label><input id="b-ref" name="reference" type="file" multiple accept="image/*"></div>
          <div><label for="b-when">Days that work</label><input id="b-when" name="days" placeholder="{{ booking.form.daysPlaceholder }}"></div>
        </div>
        <button class="send" type="submit">Send request</button>
        <p class="alt">{{ booking.form.replyNote }} A {{ site.pricing.deposit | money }} deposit locks the appointment. {{ site.pricing.depositNote }}</p>
      </form>
    </div>
  </div>
</main>
