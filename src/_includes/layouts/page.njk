---
layout: layouts/catalog.njk
---
<main class="main prose" style="margin:0 auto">
<h1>{{ heading or title }}</h1>
{%- if lede %}<p class="lede">{{ lede }}</p>{% endif %}
{%- if facts %}
<dl class="kv">
<dt>Shop</dt><dd>{{ site.shop.name }}, {{ site.shop.city }} ({{ site.shop.area }})</dd>
<dt>Days</dt><dd>{{ site.hoursLong }}</dd>
<dt>Instagram</dt><dd><a href="https://instagram.com/{{ site.instagram }}">@{{ site.instagram }}</a></dd>
<dt>Booking</dt><dd><a href="/book/">Request form</a>, <a href="{{ site.squareBooking }}">Square</a>, or DMs</dd>
<dt>Minimum</dt><dd>{{ site.pricing.shopMinimum | money }}</dd>
</dl>
{%- endif %}
{{ content | safe }}
</main>
