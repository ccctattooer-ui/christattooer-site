<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · {{ site.title }}</title>
<meta name="description" content="{{ description or site.tagline }}">
<link rel="icon" href="/assets/favicon.png">
{% include "partials/meta.njk" %}
<meta name="theme-color" content="#3B2380">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=Pixelify+Sans:wght@400;500;700&family=VT323&display=swap">
<link rel="stylesheet" href="/css/os.css">
<style>:root{--wall:{{ theme.os.wall }};--stencil:{{ theme.os.stencil }};--bone:{{ theme.os.bone }};--yellow:{{ theme.os.yellow }};--red:{{ theme.os.red }};--green:{{ theme.os.green }};--tilt:{{ theme.collage.tilt }}deg;--tape:{{ "block" if theme.collage.tape else "none" }};--colw:{{ theme.collage.columnWidth }}px}</style>
</head>
<body>
{% include "partials/signature.njk" %}
<div class="wallpaper" aria-hidden="true"></div>

<div class="menubar">
  <a class="logo" href="/"><i></i>ParlorOS</a>
  <a class="m" href="/flash/">Catalog</a><a class="m" href="/work/">Work</a><a class="m" href="/book/">Book</a>
  <div class="right"><span><i class="live"></i>{{ site.booksStatus | upper }}</span><a class="ig" href="https://instagram.com/{{ site.instagram }}">@{{ site.instagram }}</a><span id="clock"></span></div>
</div>

<nav class="icons" aria-label="Departments">
  {%- for d in departments %}
  <a class="icon{% if d.slug == dept.slug %} on{% endif %}" href="/{{ d.slug }}/"><div class="box"><img src="{{ d.iconSrc }}" alt=""></div><span>{{ d.name }}</span></a>
  {%- endfor %}
  <a class="icon" href="/flash/"><div class="box"><img src="/assets/flash/web/flash-53.webp" alt=""></div><span>Tattoos</span></a>
  <a class="icon hot" href="/book/"><div class="box"><img src="/assets/flash/web/flash-28.webp" alt=""></div><span>BOOK NOW</span></a>
</nav>

{{ content | safe }}

<div class="taskbar">
  <a class="start" href="/">{{ site.shortName | upper }}</a>
  <div id="tasks"></div>
  <span class="clock">{{ dept.status | upper }}</span>
</div>
<script>window.EGGS = {{ eggs | dump | safe }}; window.EGGS_FLASH = {{ flash | spread(7, "image") | dump | safe }};</script>
<script src="/js/os.js"></script>
<script src="/js/eggs.js" defer></script>
</body>
</html>
