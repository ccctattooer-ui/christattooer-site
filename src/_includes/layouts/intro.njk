<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · {{ site.title }}</title>
<meta name="description" content="{{ description or site.tagline }}">
<link rel="icon" href="/assets/favicon.png">
{% if not landing.enabled %}<meta http-equiv="refresh" content="0; url=/flash/">{% endif %}
<script>
  // Intro switched off in the admin, or already seen this visit? Straight to the catalog.
  {% if not landing.enabled %}location.replace('/flash/');{% endif %}
  try { if (sessionStorage.getItem('ct-entered')) location.replace('/flash/'); } catch (e) {}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=VT323&display=swap">
<link rel="stylesheet" href="/css/os.css">
<link rel="stylesheet" href="/css/intro.css">
<style>:root{--wall:{{ theme.os.wall }};--stencil:{{ theme.os.stencil }};--bone:{{ theme.os.bone }};--yellow:{{ theme.os.yellow }};--red:{{ theme.os.red }};--green:{{ theme.os.green }}}</style>
</head>
<body class="intro">
<div class="wallpaper" aria-hidden="true"></div>

<div class="menubar">
  <a class="logo" href="/"><i></i>ParlorOS</a>
  <span class="m boot-msg" aria-hidden="true">booting…</span>
  <div class="right"><span><i class="live"></i>{{ site.booksStatus | upper }}</span><a class="ig" href="https://instagram.com/{{ site.instagram }}">@{{ site.instagram }}</a><span id="clock"></span></div>
</div>

{{ content | safe }}

<div class="taskbar">
  <a class="start" href="/flash/">{{ site.shortName | upper }}</a>
  <div id="tasks"><span class="tb active">{{ landing.taskbarLabel }}</span></div>
  <span class="clock">{{ site.hoursShort | upper }}</span>
</div>
<script>
  (function () {
    var v = document.getElementById('montage');
    function enter() { try { sessionStorage.setItem('ct-entered', '1'); } catch (e) {} location.href = '/flash/'; }
    document.getElementById('enter').addEventListener('click', function (e) { e.preventDefault(); enter(); });
    var tv = document.getElementById('tv');
    tv.addEventListener('click', enter);
    tv.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); enter(); } });
    // iPhone Low Power Mode blocks autoplay until a touch; kick the video on the first one.
    if (v) { var kick = function () { v.play().catch(function () {}); }; ['pointerdown', 'touchend', 'click', 'keydown'].forEach(function (t) { document.addEventListener(t, kick, { passive: true }); }); v.play().catch(function () {}); }
    var c = document.getElementById('clock'); if (c) { var t = function () { c.textContent = new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }); }; t(); setInterval(t, 30000); }
    var msgs = {{ landing.bootMessages | dump | safe }}, i = 0, m = document.querySelector('.boot-msg');
    if (m && msgs.length) m.textContent = msgs[0];
    setInterval(function () { if (m && i < msgs.length - 1) m.textContent = msgs[++i]; }, 900);
  })();
</script>
</body>
</html>
