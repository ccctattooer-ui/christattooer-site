{#- The 88x31 button wall: old-web furniture, drawn in CSS so there are no GIFs to host and they
    stay sharp on a phone. The first one is Chris's own, for other people to link to. -#}
{%- if eggs.counter.show %}
<div class="hitbox" id="hitbox" hidden>
  <span class="hitlabel">{{ eggs.counter.label }}</span>
  <span class="odo" id="odo" aria-label="Visitor counter"></span>
</div>
{%- endif %}
{%- if eggs.badges.show %}
{#- A "|" in any of these becomes a line break. Leave one empty and it falls back to the shop
    details from Site settings, so the buttons never go stale when the shop details change. -#}
<div class="b31wall" aria-label="Web buttons">
  <span class="b31 b-own">{{ eggs.badges.own | replace("|", "<br>") | safe }}</span>
  <a class="b31 b-books" href="/book/"><i>{{ (eggs.badges.books or site.booksStatus) | upper }}</i></a>
  <a class="b31 b-space" href="/spacecraft/">{{ eggs.badges.space | replace("|", "<br>") | safe }}</a>
  <span class="b31 b-eyes">{{ eggs.badges.eyes | replace("|", "<br>") | safe }}</span>
  <span class="b31 b-made">{{ (eggs.badges.made or ("MADE IN|" + site.shop.locality + " " + site.shop.region)) | upper | replace("|", "<br>") | safe }}</span>
</div>
{%- endif %}
{% include "partials/webring.njk" %}
{%- if eggs.sparkles.show %}
<div class="knobs">
  <button type="button" id="spark-toggle" aria-pressed="false" hidden>Sparkles: off</button>
</div>
{%- endif %}
