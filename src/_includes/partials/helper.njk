{#- The shop helper: a skull that turns up once with something to say, then goes away for good.
    Everything about it — whether it shows, how long it waits, and every line it says — is in
    Shop helper in the admin (src/_data/helper.json). Starts hidden; eggs.js brings it in. -#}
{%- set showHere = helper.where == "both" or helper.where == surface %}
{%- if helper.show and helper.lines.length and showHere %}
<aside class="helper" id="helper" hidden aria-live="polite">
  <div class="helper-bubble">
    <p id="helper-line">{{ helper.lines[0] }}</p>
    <div class="helper-acts">
      <button type="button" id="helper-next">ANOTHER</button>
      <button type="button" id="helper-go">GO AWAY</button>
    </div>
  </div>
  <img class="helper-skull" src="/assets/icons/helper-skull-256.png" alt="A small skull" width="256" height="256">
</aside>
{%- endif %}
