{#- A fake POST screen, shown once ever per visitor before the TV appears. Every number on it is a
    real count from the site, so it is a boot screen and a table of contents at once. Any key or tap
    skips it, it never shows twice, and anyone who asked for reduced motion never sees it at all. -#}
{%- if eggs.bios.show %}
{%- set workCount = (work | visible) | length %}
<div class="bios" id="bios" hidden>
  <pre id="bios-text" aria-live="polite"></pre>
  <p class="bios-skip">{{ eggs.bios.skip }}</p>
</div>
<script>
  (function () {
    var COUNTS = {
      flash: "{{ flash | length }}", work: "{{ workCount }}", paintings: "{{ paintings | length }}",
      crosses: "{{ (genetics | whereNot('scrapped', true) | where('kind','spacecraft')) | length }}",
      videos: "{{ videos | length }}", books: {{ site.booksStatus | upper | dump | safe }}
    };
    var ROWS = {{ eggs.bios.rows | dump | safe }};
    var LINES = [{ t: {{ eggs.bios.title | dump | safe }} },
                 { t: {{ (site.shop.name + " · " + site.shop.city) | dump | safe }} },
                 { t: "" }];
    ROWS.forEach(function (row) {
      var bits = String(row).split("|");
      var value = (bits[1] || "").replace(/[{](\w+)[}]/g, function (_, k) { return COUNTS[k] || ""; });
      LINES.push({ l: bits[0], v: value });
    });
    LINES.push({ t: "" }, { t: {{ eggs.bios.signoff | dump | safe }} });
    var KEY = 'ct-booted';
    var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    var seen = true;
    try { seen = !!localStorage.getItem(KEY); } catch (e) {}
    if (seen || reduce) return;

    var box = document.getElementById('bios');
    var out = document.getElementById('bios-text');
    box.hidden = false;
    document.body.classList.add('booting');

    // One dial sets the pace: a row lands every lineMs, a plain line in half that, and the
    // finished screen holds for about four rows before it clears.
    var STEP = Math.max(10, Number({{ eggs.bios.lineMs | dump | safe }}) || 85);
    var FADE = Math.round(STEP * 2.5);   // scales with the dial, so halving the speed halves the lot
    var i = 0, timer;
    function pad(l, v) { var dots = Math.max(3, 30 - l.length); return l + ' ' + new Array(dots).join('.') + ' ' + v; }
    function step() {
      if (i >= LINES.length) { timer = setTimeout(done, STEP * 4); return; }
      var row = LINES[i++];
      out.textContent += (row.t !== undefined ? row.t : pad(row.l, row.v)) + '\n';
      timer = setTimeout(step, row.t !== undefined ? Math.round(STEP / 2) : STEP);
    }
    function done() {
      clearTimeout(timer);
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
      box.style.transitionDuration = FADE + 'ms';
      box.classList.add('out');
      document.body.classList.remove('booting');
      setTimeout(function () { box.remove(); }, FADE);
      window.removeEventListener('keydown', done);
      box.removeEventListener('click', done);
    }
    window.addEventListener('keydown', done);
    box.addEventListener('click', done);
    step();
  })();
</script>
{%- endif %}
