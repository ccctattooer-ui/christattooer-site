{%- set sc = genetics | where("kind", "spacecraft") %}
{%- set flags = genetics | where("flagship", true) %}
<section class="win" id="w-readme" style="left:120px;top:64px;width:min(440px,calc(100vw - 32px))">
  <div class="title"><button class="x" type="button" aria-label="Close">×</button><b>{{ dept.slug }}.txt</b></div>
  <div class="body txt">
    <h1>{{ dept.name }}</h1>
    <p>{{ dept.blurb }}</p>
    <p class="status">Status: {{ dept.status }} · {{ sc | length }} crosses · {{ flags | length }} flagships · {{ genetics | length }} plants on the chart</p>
    <p><a class="btn" href="#" data-open="w-chart">OPEN STAR CHART</a> <a class="btn ghost" href="#" data-open="w-vault">VAULT LIST</a>{% if dept.images.length %} <a class="btn ghost" href="#" data-open="w-gallery">PHOTOS</a>{% endif %}</p>
    <p class="status">Not a company. Seeds are never sold. Small batch, organic, one-time chucks.</p>
  </div>
</section>

<section class="win wide" id="w-chart" style="left:300px;top:88px;width:min(1040px,calc(100vw - 32px))">
  <div class="title"><button class="x" type="button" aria-label="Close">×</button><b>starchart.exe</b></div>
  <div class="body space">
    <div class="chart-bar">
      <span class="legend"><i class="k-sc"></i>SpaceCraft cross <i class="k-flag"></i>flagship <i class="k-cut"></i>cut / seed line <i class="k-anc"></i>ancestor</span>
      <span class="chart-tools"><button type="button" id="chart-fit">FIT</button><button type="button" id="chart-zoom-in">+</button><button type="button" id="chart-zoom-out">−</button></span>
    </div>
    <div class="chart" id="chart" aria-label="Lineage star chart: drag to pan, pinch or scroll to zoom, tap a plant for its dossier"></div>
    <p class="chart-hint">Drag to pan · pinch or scroll to zoom · tap a plant to light up its family. Time runs left to right. <span class="m-line">Gold line = mother</span> · <span class="f-line">blue line = father</span>.</p>
  </div>
</section>

<section class="win" id="w-vault" hidden style="left:180px;top:140px;width:min(560px,calc(100vw - 32px))">
  <div class="title"><button class="x" type="button" aria-label="Close">×</button><b>vault.txt ({{ sc | length }})</b></div>
  <div class="body">
    <div class="vault-tools"><input id="vault-q" type="search" placeholder="Search plants, parents, terps" aria-label="Search the vault"><label><input type="checkbox" id="vault-flag"> flagships only</label></div>
    <div class="vault" id="vault"></div>
  </div>
</section>

<section class="win" id="w-dossier" hidden style="left:560px;top:150px;width:min(460px,calc(100vw - 32px))">
  <div class="title"><button class="x" type="button" aria-label="Close">×</button><b id="dossier-name">dossier.txt</b></div>
  <div class="body dossier" id="dossier"></div>
</section>

{%- if dept.images.length %}
<section class="win" id="w-gallery" hidden style="left:420px;top:120px;width:min(620px,calc(100vw - 32px))">
  <div class="title"><button class="x" type="button" aria-label="Close">×</button><b>{{ dept.name }} photos ({{ dept.images.length }})</b></div>
  <div class="body">
    <div class="gallery">
      {%- for im in dept.images %}
      <figure><a href="{{ im.image }}"><img src="{{ im.thumb }}" alt="{{ im.caption }}" loading="lazy"></a><figcaption>{{ im.caption | slug }}.jpg</figcaption></figure>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

<script>window.GENETICS = {{ genetics | dump | safe }};</script>
<script src="/js/starchart.js" defer></script>
