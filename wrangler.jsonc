// Cloudflare Worker config: serves the built site from _site as static assets and runs the three
// small server routes in worker/index.js (admin login, price sheet API, booking email).
// Cloudflare builds and deploys this on every push to main (Workers Builds, connected in the dashboard).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "christattooer",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // ---------------------------------------------------------------------------------------------
  // Guestbook + visitor counter storage. Left commented out on purpose: a database_id that does not
  // exist makes the deploy fail, which would stop the whole site updating. Nothing breaks while it
  // is off — /api/hits and /api/guestbook just answer "not connected" and the pages stay quiet.
  //
  // To switch it on, once:
  //   npx wrangler d1 create christattooer
  //   npx wrangler d1 execute christattooer --remote --file=migrations/0001_init.sql
  // then paste the id it prints below and uncomment the block.
  //
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "christattooer", "database_id": "PASTE_THE_ID_HERE" }
  // ],
  // ---------------------------------------------------------------------------------------------

  "observability": { "enabled": true }
}
